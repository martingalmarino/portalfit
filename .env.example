# Nombre visible y reemplazo de [NOMBRE PORTAL] en los textos de Redacción.
NEXT_PUBLIC_SITE_NAME="Portal FIT"

# URL canónica, sin barra final. También arma los Open Graph y el sitemap.
# En Vercel, si falta, el build usa VERCEL_PROJECT_PRODUCTION_URL y después VERCEL_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Rótulo de dominio en el pie. Vacío = el pie no muestra dominio.
# No uses el host de Vercel como dominio público.
NEXT_PUBLIC_DOMAIN_LABEL=""

# Solo "true" habilita el indexado. Cualquier otro valor deja noindex y robots.txt en disallow.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Correo de contacto, en dos variables. No las juntes en el código.
NEXT_PUBLIC_CONTACT_EMAIL_USER=m.galmarino
NEXT_PUBLIC_CONTACT_EMAIL_DOMAIN=gmail.com
